<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InfoBlock @type="info" @icon="lightbulb" @iconSize="lg" class="mb-5">
            <div class="font-extrabold">{{t "literal.ember-ui.verify-your-email-address"}}</div>
            <div>{{t "literal.ember-ui.re-verify-your-email-address-and-click-send-to-c-cff5d"}}</div>
        </InfoBlock>
        {{#if @options.sent}}
            <InputGroup
                @type="tel"
                @name={{t "literal.ember-ui.enter-verification-code"}}
                @value={{@options.code}}
                @helpText={{t "literal.ember-ui.enter-the-code-you-received-in-your-email-please-6e798"}}
                @inputClass="input-lg"
            />
        {{else}}
            <InputGroup
                @type="email"
                @name={{t "literal.ember-ui.verify-your-email-address-90e9a"}}
                @value={{@options.email}}
                @helpText={{t "literal.ember-ui.have-a-second-look-and-confirm-your-email-addres-8d7e8"}}
                @inputClass="input-lg"
            />
        {{/if}}
    </div>
</Modal::Default>