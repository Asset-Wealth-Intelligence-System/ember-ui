<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @name={{t "literal.ember-ui.youtube-video-url"}} @value={{@options.url}} @helpText={{t "literal.ember-ui.the-url-to-the-youtube-video-you-want-to-insert"}} @inputClass="input-lg" />
        <div class="mt-2 grid grid-cols-2 gap-2">
            <InputGroup @name={{t "literal.ember-ui.height"}} @value={{@options.height}} @helpText={{t "literal.ember-ui.the-height-of-the-youtube-video"}} @inputClass="input-lg" />
            <InputGroup @name={{t "literal.ember-ui.width"}} @value={{@options.width}} @helpText={{t "literal.ember-ui.the-width-of-the-youtube-video"}} @inputClass="input-lg" />
        </div>
    </div>
</Modal::Default>