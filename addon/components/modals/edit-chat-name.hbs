<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @type="text" @name={{t "literal.ember-ui.channel-name"}} @value={{@options.channelName}} @helpText={{t "literal.ember-ui.input-a-new-name-for-your-chat-channel"}} @inputClass="input-lg" />
    </div>
</Modal::Default>